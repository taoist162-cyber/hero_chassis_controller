<?xml version="1.0"?>
<package format="2">
  <name>hero_chassis_controller</name>
  <version>0.2.0</version>
  <description>Four-wheel effort PID controller for the Hero Mecanum chassis.</description>
  <maintainer email="taoist162@gmail.com">taoist162-cyber</maintainer>
  <license>BSD</license>
  <author email="taoist162@gmail.com">taoist162-cyber</author>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>control_msgs</depend>
  <depend>control_toolbox</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>roscpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_controller</exec_depend>
  <exec_depend>rm_description_for_task</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rqt_plot</exec_depend>
  <exec_depend>rqt_reconfigure</exec_depend>
  <export>
    <controller_interface plugin="${prefix}/hero_chassis_controller_plugins.xml"/>
  </export>
</package>
